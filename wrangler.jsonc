{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketops",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Deployed as a Cloudflare Worker with static assets (@astrojs/cloudflare
  // v14 emits dist/server/wrangler.json + a config redirect for `wrangler
  // deploy`). Do NOT add pages_build_output_dir — this is not a Pages project.
  "ai": { "binding": "AI" },
  // Astro's session support requires a KV namespace named SESSION
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b4abe365e1ad493a81194cd46c4a9861"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pocketops-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocketops-db-eu",
      "database_id": "b498084c-102f-4d78-996e-f217eccde55f",
      "migrations_dir": "drizzle"
    }
  ]
}
