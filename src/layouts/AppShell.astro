---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import { env } from 'cloudflare:workers';
import { eq, isNull } from 'drizzle-orm';
import { createDb, tenantWhere } from '../db';
import { messages, tenants, users } from '../db/schema';

interface Props {
  title: string;
  active?: 'dashboard' | 'schedule' | 'jobs' | 'inbox' | 'customers' | 'settings';
}
const { title, active } = Astro.props;
const role = Astro.locals.userRole;

const db = createDb(env.DB);
const [me] = await db
  .select({ name: users.name, avatarR2Key: users.avatarR2Key })
  .from(users)
  .where(eq(users.id, Astro.locals.userId!))
  .limit(1);
const avatarSrc = me?.avatarR2Key
  ? `/api/app/avatar/${Astro.locals.userId}?v=${me.avatarR2Key.slice(-8)}`
  : null;
const [tenant] = await db
  .select({ name: tenants.name })
  .from(tenants)
  .where(eq(tenants.id, Astro.locals.tenantId!))
  .limit(1);
const initials = (me?.name ?? '?')
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const unreadRows = await db
  .select({ id: messages.id })
  .from(messages)
  .where(tenantWhere(messages, Astro.locals.tenantId!, eq(messages.direction, 'in'), isNull(messages.readAt)));
const unread = unreadRows.length;

const nav = [
  { id: 'dashboard', href: '/dashboard', label: 'Home', icon: 'M3 12l9-9 9 9M5 10v10h5v-6h4v6h5V10' },
  { id: 'schedule', href: '/dashboard/schedule', label: 'Schedule', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { id: 'jobs', href: '/dashboard/jobs', label: 'Jobs', icon: 'M6 7V5a2 2 0 012-2h8a2 2 0 012 2v2m-14 0h16a1 1 0 011 1v11a1 1 0 01-1 1H4a1 1 0 01-1-1V8a1 1 0 011-1z' },
  { id: 'inbox', href: '/dashboard/inbox', label: 'Inbox', icon: 'M8 10h8m-8 4h5m8-2a9 9 0 11-18 0 9 9 0 0118 0zm-9 9l-3-3' },
  { id: 'customers', href: '/dashboard/customers', label: 'Customers', icon: 'M17 20v-1a4 4 0 00-4-4H7a4 4 0 00-4 4v1m18 0v-1a4 4 0 00-3-3.87M15 3.13a4 4 0 010 7.75M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
] as const;
const adminNav = [
  { id: 'settings', href: '/dashboard/settings', label: 'Settings', icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zm7.4-3a7.4 7.4 0 00-.1-1.2l2-1.6-2-3.4-2.4 1a7.5 7.5 0 00-2-1.2L14.5 3h-5l-.4 2.6a7.5 7.5 0 00-2 1.2l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 000 2.4l-2 1.6 2 3.4 2.4-1a7.5 7.5 0 002 1.2l.4 2.6h5l.4-2.6a7.5 7.5 0 002-1.2l2.4 1 2-3.4-2-1.6c.07-.4.1-.8.1-1.2z' },
] as const;

const itemClass = (id: string) =>
  `flex min-h-12 items-center gap-3 rounded-lg px-3 text-sm font-medium transition-colors ${
    active === id ? 'bg-shell-3 text-white' : 'text-shell-text hover:bg-shell-2 hover:text-white'
  }`;
---

<html lang="en" data-app>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f6f9" />
    <ThemeInit />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>{title} · Pocket Ops</title>
  </head>
  <body class="min-h-screen bg-surface text-body pb-24 lg:pb-10">
    <!-- Sidebar (desktop) -->
    <aside class="fixed inset-y-0 left-0 z-20 hidden w-60 flex-col border-r border-shell-edge bg-shell lg:flex">
      <a href="/dashboard" class="flex items-center gap-3 px-5 py-5">
        <img src="/icons/icon-192.png" alt="Pocket Ops" class="h-10 w-10 rounded-xl bg-white object-cover" />
        <span class="min-w-0">
          <span class="block text-sm font-bold tracking-widest text-white">POCKET OPS</span>
          <span class="block truncate text-[11px] uppercase tracking-wider text-shell-dim">{tenant?.name}</span>
        </span>
      </a>
      <nav class="flex-1 space-y-1 overflow-y-auto px-3 pt-2">
        {nav.map((item) => (
          <a href={item.href} class={itemClass(item.id)}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            {item.label}
            {item.id === 'inbox' && unread > 0 && (
              <span class="ml-auto rounded-full bg-accent px-2 py-0.5 text-xs font-bold text-white">{unread}</span>
            )}
          </a>
        ))}
        <p class="px-3 pb-1 pt-5 text-[11px] font-semibold uppercase tracking-widest text-shell-dim">Admin</p>
        {adminNav.map((item) => (
          <a href={item.href} class={itemClass(item.id)}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="border-t border-shell-edge p-3">
        <div class="flex items-center gap-3 rounded-lg px-2 py-2">
          <a href="/dashboard/settings/profile" class="flex min-w-0 flex-1 items-center gap-3" title="My profile">
            {avatarSrc ? (
              <img src={avatarSrc} alt="" class="h-9 w-9 shrink-0 rounded-full object-cover" />
            ) : (
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-bold text-white">{initials}</span>
            )}
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-white">{me?.name}</span>
              <span class="block text-xs capitalize text-shell-dim">{role}</span>
            </span>
          </a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="flex min-h-12 min-w-10 items-center justify-center rounded-lg text-shell-dim hover:text-white" aria-label="Log out" title="Log out">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Top bar -->
    <header class="sticky top-0 z-10 border-b border-edge bg-surface/95 backdrop-blur lg:pl-60">
      <div class="flex items-center gap-4 px-4 py-3 lg:px-8">
        <a href="/dashboard" class="flex items-center gap-2 font-bold lg:hidden">
          <img src="/icons/icon-192.png" alt="Pocket Ops" class="h-8 w-8 rounded-lg bg-white object-cover" />
        </a>
        <h1 class="text-base font-bold">{title}</h1>
        <form method="GET" action="/dashboard/jobs" class="hidden flex-1 justify-center md:flex">
          <input
            type="search"
            name="q"
            placeholder="Search jobs, customers…"
            class="w-full max-w-md min-h-12 rounded-full border border-edge-2 bg-card px-5 text-sm placeholder-faint focus:border-accent focus:outline-none"
          />
        </form>
        <div class="ml-auto flex items-center gap-3">
          <button
            type="button"
            id="theme-toggle"
            class="flex min-h-12 min-w-12 items-center justify-center rounded-lg text-dim hover:bg-card-2 hover:text-body"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          </button>
          <a href="/dashboard/settings/profile" class="flex items-center gap-3" title="My profile">
            {avatarSrc ? (
              <img src={avatarSrc} alt="" class="h-9 w-9 rounded-full object-cover" />
            ) : (
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent text-xs font-bold text-white">{initials}</span>
            )}
            <span class="hidden text-sm font-medium sm:block">{me?.name?.split(' ')[0]}</span>
          </a>
          <form method="POST" action="/api/auth/logout" class="lg:hidden">
            <button type="submit" class="min-h-12 rounded-lg px-2 text-sm text-dim hover:text-body">Log out</button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-6 lg:pl-64 lg:pr-8 xl:mx-0 xl:max-w-none">
      <div class="mx-auto max-w-5xl">
        <slot />
      </div>
    </main>

    <!-- Quick action: new job -->
    <a
      href="/dashboard/jobs/new"
      class="fixed bottom-24 right-4 z-20 flex min-h-14 items-center gap-2 rounded-full bg-accent px-5 font-semibold text-white shadow-lg shadow-black/20 hover:bg-accent-2 lg:bottom-6 lg:right-6"
    >
      <span class="text-xl leading-none">+</span> New job
    </a>

    <!-- Fat-finger bottom nav (mobile) -->
    <nav class="fixed inset-x-0 bottom-0 z-10 border-t border-edge bg-surface/95 backdrop-blur lg:hidden">
      <div class="grid grid-cols-6">
        {[...nav, ...adminNav].map((tab) => (
          <a
            href={tab.href}
            class={`relative flex min-h-16 flex-col items-center justify-center gap-1 text-[10px] ${
              active === tab.id ? 'text-accent-text' : 'text-dim hover:text-body'
            }`}
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={tab.icon} />
            </svg>
            {tab.label}
            {tab.id === 'inbox' && unread > 0 && (
              <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-accent" />
            )}
          </a>
        ))}
      </div>
    </nav>

    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
        el.dataset.theme = next;
        document.cookie = `theme=${next};path=/;max-age=31536000;SameSite=Lax`;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', next === 'dark' ? '#0b1524' : '#f4f6f9');
      });
    </script>
  </body>
</html>
