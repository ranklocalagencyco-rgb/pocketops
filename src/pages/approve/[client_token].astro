---
/**
 * Public magic-link portal (Module 6, extended).
 *  - quoted: customer reviews the quote, accepts it (optionally paying a
 *    deposit via Stripe) — no account, no password.
 *  - approved → completed: "quote accepted" summary.
 *  - invoiced: one-tap payment of the outstanding balance.
 *  - paid: receipt.
 * Costs/margins are NEVER selected here.
 */
import '../../styles/global.css';
import { env } from 'cloudflare:workers';
import { and, asc, eq } from 'drizzle-orm';
import { createDb } from '../../db';
import { customers, jobLineItems, jobs, payments, signatures, tenantDocuments, tenants } from '../../db/schema';
import { cisDeductionCents, fmtDateTz, fmtMoney, parseMoney } from '../../lib/jobs';
import { notifyTenant } from '../../lib/notify';
import { getStripe, platformFeeCents } from '../../lib/stripe';

const token = Astro.params.client_token ?? '';
if (token.length < 21) return new Response('Not found', { status: 404 });

const db = createDb(env.DB);
const [job] = await db.select().from(jobs).where(eq(jobs.clientToken, token)).limit(1);
if (!job || job.status === 'lead' || job.status === 'cancelled') {
  return new Response('Not found', { status: 404 });
}

const [tenant] = await db.select().from(tenants).where(eq(tenants.id, job.tenantId)).limit(1);
const [customer] = await db
  .select({ name: customers.name })
  .from(customers)
  .where(eq(customers.id, job.customerId))
  .limit(1);
// Public column allowlist — cost never leaves the server
const items = await db
  .select({
    id: jobLineItems.id,
    kind: jobLineItems.kind,
    description: jobLineItems.description,
    quantity: jobLineItems.quantity,
    unitPriceCents: jobLineItems.unitPriceCents,
  })
  .from(jobLineItems)
  .where(eq(jobLineItems.jobId, job.id))
  .orderBy(asc(jobLineItems.sortOrder), asc(jobLineItems.id));
const sigs = await db
  .select({ signerName: signatures.signerName, imageDataUrl: signatures.imageDataUrl, signedAt: signatures.signedAt })
  .from(signatures)
  .where(eq(signatures.jobId, job.id));
// "Our credentials" — company documents the business chose to show customers
const credentials = await db
  .select({ name: tenantDocuments.name, shareToken: tenantDocuments.shareToken })
  .from(tenantDocuments)
  .where(and(eq(tenantDocuments.tenantId, job.tenantId), eq(tenantDocuments.showOnPortal, true)));

const stripe = getStripe(env);
// Stripe Connect: charges are created ON the business's own account, so the
// money settles with them. No connected account = no online payments.
const stripeAccount =
  tenant?.stripeAccountId && tenant.stripeChargesEnabled ? tenant.stripeAccountId : null;
const currency = tenant?.currency;
const money = (c: number) => fmtMoney(c, currency);
const origin = env.APP_URL || Astro.url.origin;

const paymentRows = await db
  .select({ amountCents: payments.amountCents, status: payments.status })
  .from(payments)
  .where(eq(payments.jobId, job.id));
const paidSoFarCents = paymentRows
  .filter((p) => p.status === 'succeeded')
  .reduce((s, p) => s + p.amountCents, 0);
const cisCents = job.cisReverseCharge ? cisDeductionCents(items) : 0;

const isQuote = job.status === 'quoted';
const isAccepted = ['approved', 'scheduled', 'in_progress', 'completed'].includes(job.status);
const payable = job.status === 'invoiced';
const isPaid = job.status === 'paid';
const balanceCents = Math.max(0, job.totalCents - cisCents - paidSoFarCents);
const depositCents = Math.round((job.totalCents * (tenant?.depositRateBps ?? 0)) / 10_000);
const depositViaStripe = Boolean(stripe) && Boolean(stripeAccount) && depositCents >= 50;

let formError = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'accept' && isQuote) {
    const acceptName = String(form.get('acceptName') ?? '').trim().slice(0, 80);
    if (!acceptName) {
      formError = 'Please enter your name to accept the quote.';
    } else if (depositViaStripe && stripe && stripeAccount) {
      try {
        const fee = platformFeeCents(env, depositCents);
        const session = await stripe.checkout.sessions.create(
          {
            mode: 'payment',
            line_items: [
              {
                price_data: {
                  currency: currency ?? 'gbp',
                  product_data: { name: `Deposit — ${tenant?.name}: ${job.title}` },
                  unit_amount: depositCents,
                },
                quantity: 1,
              },
            ],
            ...(fee > 0 ? { payment_intent_data: { application_fee_amount: fee } } : {}),
            success_url: `${origin}/approve/${token}?accepted=1`,
            cancel_url: `${origin}/approve/${token}`,
            metadata: { jobId: job.id, tenantId: job.tenantId, type: 'deposit', acceptName },
          },
          { stripeAccount },
        );
        if (session.url) return Astro.redirect(session.url, 303);
        formError = 'Could not start the deposit payment. Please try again.';
      } catch {
        formError = 'Could not start the deposit payment. Please try again.';
      }
    } else {
      await db
        .update(jobs)
        .set({ status: 'approved', quoteAcceptedAt: new Date(), quoteAcceptedName: acceptName, updatedAt: new Date() })
        .where(eq(jobs.id, job.id));
      await notifyTenant(db, job.tenantId, 'quoteAccepted', {
        title: 'Quote accepted',
        body: `${acceptName} accepted "${job.title}" (${fmtMoney(job.totalCents, currency ?? 'gbp')})`,
        url: `/dashboard/jobs/${job.id}`,
        tag: `accept-${job.id}`,
      });
      return Astro.redirect(`/approve/${token}?accepted=1`, 303);
    }
  } else if (intent === 'pay' && payable) {
    // Staged payments: pay the full balance or a part-payment of choice
    const requested = parseMoney(form.get('amount'));
    const chargeCents = Math.min(requested && requested >= 50 ? requested : balanceCents, balanceCents);
    if (!stripe || !stripeAccount) {
      formError = 'Online payment is not available yet — contact us to pay.';
    } else if (chargeCents < 50) {
      formError = 'This balance is below the card-payment minimum.';
    } else {
      try {
        const fee = platformFeeCents(env, chargeCents);
        const session = await stripe.checkout.sessions.create(
          {
            mode: 'payment',
            line_items: [
              {
                price_data: {
                  currency: currency ?? 'gbp',
                  product_data: { name: `${tenant?.name ?? 'Invoice'} — ${job.title}` },
                  unit_amount: chargeCents,
                },
                quantity: 1,
              },
            ],
            ...(fee > 0 ? { payment_intent_data: { application_fee_amount: fee } } : {}),
            success_url: `${origin}/approve/${token}?paid=1`,
            cancel_url: `${origin}/approve/${token}`,
            metadata: { jobId: job.id, tenantId: job.tenantId, type: 'balance' },
          },
          { stripeAccount },
        );
        if (session.url) return Astro.redirect(session.url, 303);
        formError = 'Could not start checkout. Please try again.';
      } catch {
        formError = 'Could not start checkout. Please try again.';
      }
    }
  }
}

const justPaid = Astro.url.searchParams.get('paid') === '1';
const justAccepted = Astro.url.searchParams.get('accepted') === '1';
const heading = isQuote ? 'Quote' : 'Invoice';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{heading} from {tenant?.name ?? 'Pocket Ops'}</title>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-900">
    <main class="mx-auto max-w-lg space-y-5 p-4 pb-36">
      <header class="pt-6 text-center">
        {tenant?.logoR2Key && (
          <img src={`/logo/${tenant.slug}`} alt={tenant?.name} class="mx-auto mb-3 h-16 w-auto max-w-[220px] object-contain" />
        )}
        <p class="text-sm uppercase tracking-widest text-zinc-500">{heading}</p>
        <h1 class="text-2xl font-bold">{tenant?.name}</h1>
        {(() => {
          const addr = [tenant?.addressLine1, tenant?.city, tenant?.postalCode].filter(Boolean).join(' · ');
          return addr ? <p class="text-xs text-zinc-400">{addr}</p> : null;
        })()}
        {tenant?.phone && <p class="text-zinc-500">{tenant.phone}</p>}
        {tenant?.vatNumber && <p class="text-xs text-zinc-400">VAT No. {tenant.vatNumber}</p>}
      </header>

      {(isPaid || justPaid) && (
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-5 text-center">
          <p class="text-3xl">✓</p>
          <p class="mt-1 text-lg font-semibold text-emerald-800">
            {isPaid ? 'Paid — thank you!' : 'Payment received — finalising your receipt…'}
          </p>
          {job.paidAt && <p class="text-sm text-emerald-700">{fmtDateTz(job.paidAt, tenant?.timezone)}</p>}
        </div>
      )}

      {(isAccepted || (justAccepted && !payable && !isPaid)) && (
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-5 text-center">
          <p class="text-lg font-semibold text-emerald-800">✓ Quote accepted{job.quoteAcceptedName ? ` by ${job.quoteAcceptedName}` : ''}</p>
          {job.quoteAcceptedAt && <p class="text-sm text-emerald-700">{fmtDateTz(job.quoteAcceptedAt, tenant?.timezone)}</p>}
          {job.depositPaidCents > 0 && <p class="mt-1 text-sm text-emerald-700">Deposit paid: {money(job.depositPaidCents)}</p>}
          <p class="mt-2 text-sm text-emerald-700">We'll be in touch to book you in.</p>
        </div>
      )}

      <section class="rounded-2xl bg-white p-5 shadow-sm">
        <p class="font-semibold">{job.title}</p>
        <p class="text-sm text-zinc-500">For {customer?.name}</p>
        {job.description && <p class="mt-2 text-sm text-zinc-600">{job.description}</p>}

        <div class="mt-4 divide-y divide-zinc-100">
          {items.map((li) => (
            <div class="flex items-baseline justify-between gap-3 py-2.5">
              <div>
                <p class="text-sm font-medium">{li.description}</p>
                <p class="text-xs text-zinc-500">{li.quantity} × {money(li.unitPriceCents)}</p>
              </div>
              <p class="text-sm font-semibold">{money(Math.round(li.quantity * li.unitPriceCents))}</p>
            </div>
          ))}
        </div>
        {(job.taxCents > 0 || paidSoFarCents > 0 || cisCents > 0) && (
          <div class="mt-3 space-y-1 border-t border-zinc-200 pt-3 text-sm text-zinc-600">
            <div class="flex items-baseline justify-between"><p>Subtotal</p><p>{money(job.subtotalCents)}</p></div>
            {job.taxCents > 0 && (
              <div class="flex items-baseline justify-between"><p>VAT</p><p>{money(job.taxCents)}</p></div>
            )}
            {cisCents > 0 && (
              <div class="flex items-baseline justify-between"><p>Less CIS deduction (20% of labour)</p><p>−{money(cisCents)}</p></div>
            )}
            {paidSoFarCents > 0 && (
              <div class="flex items-baseline justify-between"><p>Payments received</p><p>−{money(paidSoFarCents)}</p></div>
            )}
          </div>
        )}
        <div class={`mt-3 flex items-baseline justify-between ${job.taxCents > 0 || paidSoFarCents > 0 || cisCents > 0 ? '' : 'border-t border-zinc-200 pt-3'}`}>
          <p class="font-semibold">{isQuote ? 'Quote total' : isPaid ? 'Total paid' : 'Balance due'}</p>
          <p class="text-2xl font-bold">{money(isQuote || isPaid ? job.totalCents : balanceCents)}</p>
        </div>
        {job.cisReverseCharge && (
          <p class="mt-2 text-xs text-zinc-500">Domestic reverse charge: customer to account for VAT to HMRC under the CIS reverse charge rules.</p>
        )}
      </section>

      {sigs.length > 0 && (
        <section class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm font-semibold text-zinc-500">Authorised on site</p>
          {sigs.map((s) => (
            <div class="mt-2">
              <img src={s.imageDataUrl} alt={`Signature from ${s.signerName}`} class="max-h-24" />
              <p class="text-xs text-zinc-500">{s.signerName} — {s.signedAt.toLocaleDateString('en-GB')}</p>
            </div>
          ))}
        </section>
      )}

      {credentials.length > 0 && (
        <section class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm font-semibold text-zinc-500">Our credentials</p>
          <div class="mt-1 divide-y divide-zinc-100">
            {credentials.map((d) => (
              <a href={`/docs/${d.shareToken}`} target="_blank" class="flex min-h-12 items-center justify-between gap-3 py-2">
                <span class="text-sm font-medium">📄 {d.name}</span>
                <span class="text-xs font-semibold text-zinc-400">View →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {formError && <p class="rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">{formError}</p>}

      {isQuote && (
        <div class="fixed inset-x-0 bottom-0 border-t border-zinc-200 bg-white/95 p-4 backdrop-blur">
          <form method="POST" class="mx-auto max-w-lg space-y-2">
            <input type="hidden" name="intent" value="accept" />
            <input name="acceptName" required placeholder="Your full name" class="w-full min-h-12 rounded-xl border border-zinc-300 px-4 text-base" />
            <button type="submit" class="w-full min-h-14 rounded-2xl bg-zinc-900 text-lg font-semibold text-white active:scale-[0.99]">
              {depositViaStripe ? `Accept & pay ${money(depositCents)} deposit` : 'Accept quote'}
            </button>
            <p class="text-center text-xs text-zinc-500">
              {depositViaStripe
                ? ' Pay · Google Pay · Card — secured by Stripe'
                : 'By accepting you agree to the work and pricing above.'}
            </p>
          </form>
        </div>
      )}

      {payable && !justPaid && stripe && stripeAccount && (
        <div class="fixed inset-x-0 bottom-0 border-t border-zinc-200 bg-white/95 p-4 backdrop-blur">
          <form method="POST" class="mx-auto max-w-lg">
            <input type="hidden" name="intent" value="pay" />
            <button type="submit" class="w-full min-h-14 rounded-2xl bg-zinc-900 text-lg font-semibold text-white active:scale-[0.99]">
              Pay {money(balanceCents)}
            </button>
            <div class="mt-2 flex items-center justify-center gap-2 text-xs text-zinc-500">
              <span>or pay part now:</span>
              <input name="amount" inputmode="decimal" placeholder="0.00" class="h-9 w-24 rounded-lg border border-zinc-300 px-2 text-sm" />
              <span> Pay · Google Pay · Card</span>
            </div>
          </form>
        </div>
      )}

      {payable && !justPaid && !(stripe && stripeAccount) && (
        <div class="fixed inset-x-0 bottom-0 border-t border-zinc-200 bg-white/95 p-4 text-center backdrop-blur">
          <p class="mx-auto max-w-lg text-sm text-zinc-600">
            To pay this invoice, contact {tenant?.name}{tenant?.phone ? ` on ${tenant.phone}` : ''}.
          </p>
        </div>
      )}
    </main>
  </body>
</html>
