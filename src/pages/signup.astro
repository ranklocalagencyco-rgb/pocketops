---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import { env } from 'cloudflare:workers';
import { eq } from 'drizzle-orm';
import { createDb } from '../db';
import { tenants, users } from '../db/schema';
import { newId } from '../lib/ids';
import { hashPassword } from '../lib/password';
import { clientIp } from '../lib/request';
import { createSession, SESSION_COOKIE, sessionCookieOptions } from '../lib/session';

if (Astro.locals.userId) return Astro.redirect('/dashboard');

let error = '';
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const businessName = String(form.get('businessName') ?? '').trim();
    const name = String(form.get('name') ?? '').trim();
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const password = String(form.get('password') ?? '');

    if (!businessName || !name || !email.includes('@') || password.length < 8) {
      error = 'All fields required; password must be at least 8 characters.';
    } else {
      const db = createDb(env.DB);
      const existing = await db.select({ id: users.id }).from(users).where(eq(users.email, email)).limit(1);
      if (existing.length > 0) {
        error = 'That email is already registered.';
      } else {
        const tenantId = newId();
        const slug =
          businessName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 30) +
          '-' + newId().slice(0, 6).toLowerCase();
        // UK-market defaults; adjustable in Settings → Regional & VAT
        await db.insert(tenants).values({
          id: tenantId,
          name: businessName,
          slug,
          currency: 'gbp',
          timezone: 'Europe/London',
          taxRateBps: 2000,
        });
        const userId = newId();
        await db.insert(users).values({
          id: userId,
          tenantId,
          email,
          passwordHash: await hashPassword(password),
          name,
          role: 'owner',
        });
        const { token, expiresAt } = await createSession(db, {
          tenantId,
          userId,
          ip: clientIp(Astro.request),
          userAgent: Astro.request.headers.get('user-agent'),
        });
        Astro.cookies.set(SESSION_COOKIE, token, sessionCookieOptions(expiresAt));
        return Astro.redirect('/dashboard');
      }
    }
  } catch (err) {
    console.error('[signup]', err);
    error = 'Signup failed. Please try again.';
  }
}
---

<html lang="en" data-app>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>Create your account · Pocket Ops</title>
  </head>
  <body class="min-h-screen bg-surface text-body flex items-center justify-center p-4">
    <main class="w-full max-w-sm space-y-6">
      <div class="text-center">
        <img src="/icons/icon-192.png" alt="Pocket Ops" class="mx-auto h-16 w-16 rounded-2xl bg-white object-cover shadow-lg" />
        <h1 class="mt-3 text-2xl font-bold">Pocket Ops</h1>
        <p class="mt-1 text-dim">Set up your company workspace</p>
      </div>
      {error && <p class="rounded-lg bg-red-950 border border-red-800 px-4 py-3 text-sm text-red-300">{error}</p>}
      <form method="POST" class="space-y-4">
        <input name="businessName" required placeholder="Business name" class="w-full min-h-12 rounded-xl border border-edge-2 bg-card px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <input name="name" required placeholder="Your name" class="w-full min-h-12 rounded-xl border border-edge-2 bg-card px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <input name="email" type="email" required placeholder="Email" class="w-full min-h-12 rounded-xl border border-edge-2 bg-card px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <input name="password" type="password" required minlength="8" placeholder="Password (8+ characters)" class="w-full min-h-12 rounded-xl border border-edge-2 bg-card px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <button type="submit" class="w-full min-h-12 rounded-xl bg-primary font-semibold text-white hover:bg-primary-2">
          Create workspace
        </button>
      </form>
      <p class="text-center text-sm text-dim">
        Already set up? <a href="/login" class="text-accent-text hover:underline">Log in</a>
      </p>
      <p class="text-center text-xs text-faint">
        By signing up you agree to the <a href="/terms" class="underline hover:text-dim">Terms</a> and <a href="/privacy" class="underline hover:text-dim">Privacy Policy</a>
      </p>
    </main>
  </body>
</html>
