---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { eq } from 'drizzle-orm';
import { createDb } from '../db';
import { users } from '../db/schema';
import { createPasswordReset } from '../lib/password-reset';
import { sendMail } from '../lib/mail';

if (Astro.locals.userId) return Astro.redirect('/dashboard');

let submitted = false;
let error = '';
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    if (!email.includes('@')) {
      error = 'Enter a valid email address.';
    } else {
      const db = createDb(env.DB);
      const [user] = await db.select().from(users).where(eq(users.email, email)).limit(1);
      // Always show the same success message — no account enumeration.
      if (user && user.isActive) {
        const { token } = await createPasswordReset(db, user);
        const resetUrl = `${env.APP_URL || Astro.url.origin}/reset-password/${token}`;
        const result = await sendMail(env, {
          to: email,
          subject: 'Reset your Pocket Ops password',
          text: `Click the link below to set a new password. This link expires in 1 hour and can only be used once.\n\n${resetUrl}\n\nIf you didn't request this, you can ignore this email.`,
        });
        if (!result.ok) console.error('[forgot-password] send failed:', result.error);
      }
      submitted = true;
    }
  } catch (err) {
    console.error('[forgot-password]', err);
    error = 'Something went wrong. Please try again.';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>Reset password · Pocket Ops</title>
  </head>
  <body class="min-h-screen bg-ink-950 text-stone-100 flex items-center justify-center p-4">
    <main class="w-full max-w-sm space-y-6">
      <div class="text-center">
        <img src="/icons/icon-192.png" alt="Pocket Ops" class="mx-auto h-16 w-16 rounded-2xl bg-white object-cover shadow-lg" />
        <h1 class="mt-3 text-2xl font-bold">Pocket Ops</h1>
        <p class="mt-1 text-stone-400">Reset your password</p>
      </div>
      {error && <p class="rounded-lg bg-red-950 border border-red-800 px-4 py-3 text-sm text-red-300">{error}</p>}
      {submitted ? (
        <p class="rounded-lg bg-ink-900 border border-ink-600 px-4 py-3 text-sm text-stone-300">
          If an account exists for that email, a reset link is on its way. Check your inbox (and spam folder) — the link expires in 1 hour.
        </p>
      ) : (
        <form method="POST" class="space-y-4">
          <input name="email" type="email" required placeholder="Email" autocomplete="email" class="w-full min-h-12 rounded-xl border border-ink-600 bg-ink-900 px-4 text-base placeholder-stone-500 focus:border-amber-500 focus:outline-none" />
          <button type="submit" class="w-full min-h-12 rounded-xl bg-orange-600 font-semibold text-white hover:bg-orange-500">
            Send reset link
          </button>
        </form>
      )}
      <p class="text-center text-sm text-stone-400">
        <a href="/login" class="text-amber-400 hover:underline">Back to log in</a>
      </p>
    </main>
  </body>
</html>
