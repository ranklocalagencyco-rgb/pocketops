---
/**
 * Payments settings — Stripe Connect (Standard).
 * Each business connects its OWN Stripe account; customer payments settle
 * straight to their bank. Pocket Ops never touches the money.
 */
import { env } from 'cloudflare:workers';
import { eq } from 'drizzle-orm';
import { createDb } from '../../../db';
import { tenants } from '../../../db/schema';
import AppShell from '../../../layouts/AppShell.astro';
import { canSeeFinancials } from '../../../lib/masking';
import { getStripe } from '../../../lib/stripe';

if (!canSeeFinancials(Astro.locals.userRole!)) return Astro.redirect('/dashboard/settings');

const db = createDb(env.DB);
const [tenant] = await db
  .select()
  .from(tenants)
  .where(eq(tenants.id, Astro.locals.tenantId!))
  .limit(1);
if (!tenant) return Astro.redirect('/dashboard/settings');

const stripe = getStripe(env);
const platformReady = Boolean(stripe);

// Onboarding can finish out-of-band (email verification, etc.) — re-check
// the account whenever the stored flag says "not yet".
let chargesEnabled = tenant.stripeChargesEnabled;
if (stripe && tenant.stripeAccountId && !chargesEnabled) {
  try {
    const account = await stripe.accounts.retrieve(tenant.stripeAccountId);
    if (account.charges_enabled) {
      chargesEnabled = true;
      await db
        .update(tenants)
        .set({ stripeChargesEnabled: true })
        .where(eq(tenants.id, tenant.id));
    }
  } catch {
    // Show the stored state; the connect button mints a fresh onboarding link
  }
}

const connected = Boolean(tenant.stripeAccountId);
const live = connected && chargesEnabled;
const hadError = Astro.url.searchParams.get('error') === 'stripe';

const statusText = live
  ? '● Payments are live — money goes straight to your bank'
  : connected
    ? '○ Nearly there — finish your Stripe setup to start taking payments.'
    : '○ Not connected yet — connect Stripe to take card payments.';
---

<AppShell title="Payments" active="settings">
  <div class="mx-auto max-w-xl space-y-5">
    <div>
      <a href="/dashboard/settings" class="text-sm text-dim hover:text-body">← Settings</a>
      <h2 class="mt-1 text-2xl font-bold">Payments</h2>
      <p class="text-sm text-dim">One-tap Stripe Checkout on every invoice link — Apple Pay, Google Pay, and cards — paid directly into your own Stripe account.</p>
    </div>

    {hadError && (
      <p class="rounded-xl border border-red-800 bg-red-950/40 px-4 py-3 text-sm text-red-300">Couldn't reach Stripe just then — try again.</p>
    )}

    <p class={`rounded-xl border px-4 py-3 text-sm font-medium ${live ? 'border-emerald-800 bg-emerald-950 text-emerald-300' : 'border-accent-edge bg-accent-soft/60 text-accent-text'}`}>
      {statusText}
    </p>

    <div class="space-y-3 rounded-2xl border border-edge bg-card p-5">
      <p class="font-semibold">Your Stripe account</p>
      {!platformReady ? (
        <p class="text-sm text-dim">Online payments aren't available on this Pocket Ops installation yet. Check back soon.</p>
      ) : live ? (
        <>
          <p class="text-sm text-dim">Connected as <span class="font-mono text-xs text-accent-text">{tenant.stripeAccountId}</span>. Payouts, refunds, and disputes are managed in your own Stripe dashboard.</p>
          <a href="https://dashboard.stripe.com" target="_blank" rel="noopener" class="inline-flex min-h-12 items-center rounded-xl border border-edge-2 px-4 text-sm font-semibold text-body hover:bg-card-2">Open Stripe dashboard ↗</a>
        </>
      ) : (
        <>
          <p class="text-sm text-dim">
            {connected
              ? 'Your Stripe account was created but setup isn’t finished. Pick up where you left off — it usually takes a few minutes.'
              : 'Connect a free Stripe account (or link an existing one) so customers can pay invoices by card, Apple Pay, or Google Pay. Payouts land in your business bank account, usually within 2 working days.'}
          </p>
          <a href="/api/integrations/stripe/connect" class="inline-flex min-h-12 items-center rounded-xl bg-primary hover:bg-primary-2 px-5 text-sm font-semibold text-white active:scale-[0.99]">
            {connected ? 'Finish Stripe setup' : 'Connect Stripe'}
          </a>
        </>
      )}
    </div>

    <div class="rounded-2xl border border-edge bg-card p-5 text-sm text-dim">
      <p class="font-semibold text-body">How customers pay</p>
      <p class="mt-1">When a job moves to <span class="text-accent-text">Invoiced</span>, its job page shows a secure payment link. Text it to the customer — they tap once, pay with Apple Pay, Google Pay, or a card, and the job flips to <span class="text-emerald-300">Paid</span> automatically, firing the review text and accounting sync. The money settles in your Stripe account, never anyone else's.</p>
    </div>
  </div>
</AppShell>
