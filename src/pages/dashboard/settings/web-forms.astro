---
import { env } from 'cloudflare:workers';
import { asc, desc, eq } from 'drizzle-orm';
import AppShell from '../../../layouts/AppShell.astro';
import { createDb, tenantValues, tenantWhere } from '../../../db';
import { jobSources, webForms } from '../../../db/schema';
import { newClientToken, newId } from '../../../lib/ids';
import { canSeeFinancials } from '../../../lib/masking';

if (!canSeeFinancials(Astro.locals.userRole!)) return Astro.redirect('/dashboard/settings');
const tenantId = Astro.locals.tenantId!;
const db = createDb(env.DB);

let notice = '';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'add') {
    const name = String(form.get('name') ?? '').trim().slice(0, 60);
    const intro = String(form.get('intro') ?? '').trim().slice(0, 300) || null;
    const sourceIdRaw = String(form.get('sourceId') ?? '');
    if (!name) {
      error = 'Give the form a name.';
    } else {
      const [source] = sourceIdRaw
        ? await db
            .select({ id: jobSources.id })
            .from(jobSources)
            .where(tenantWhere(jobSources, tenantId, eq(jobSources.id, sourceIdRaw)))
            .limit(1)
        : [];
      await db.insert(webForms).values(
        tenantValues(tenantId, {
          id: newId(),
          name,
          intro,
          token: newClientToken(),
          sourceId: source?.id ?? null,
        }),
      );
      notice = 'Form created — copy the embed code below.';
    }
  } else if (intent === 'toggle') {
    const id = String(form.get('formId') ?? '');
    const [f] = await db
      .select({ isActive: webForms.isActive })
      .from(webForms)
      .where(tenantWhere(webForms, tenantId, eq(webForms.id, id)))
      .limit(1);
    if (f) {
      await db
        .update(webForms)
        .set({ isActive: !f.isActive })
        .where(tenantWhere(webForms, tenantId, eq(webForms.id, id)));
    }
  } else if (intent === 'delete') {
    await db
      .delete(webForms)
      .where(tenantWhere(webForms, tenantId, eq(webForms.id, String(form.get('formId') ?? ''))));
    notice = 'Form deleted — any embedded copies will show "Not found".';
  }
}

const forms = await db
  .select()
  .from(webForms)
  .where(tenantWhere(webForms, tenantId))
  .orderBy(desc(webForms.createdAt));
const sources = await db
  .select({ id: jobSources.id, name: jobSources.name })
  .from(jobSources)
  .where(tenantWhere(jobSources, tenantId, eq(jobSources.isActive, true)))
  .orderBy(asc(jobSources.name));
const base = env.APP_URL || Astro.url.origin;
const embed = (token: string) =>
  `<iframe src="${base}/form/${token}" style="width:100%;max-width:480px;height:560px;border:0;" title="Request a quote"></iframe>`;
---

<AppShell title="Web forms" active="settings">
  <div class="mx-auto max-w-xl space-y-5">
    <div>
      <a href="/dashboard/settings" class="text-sm text-dim hover:text-body">← Settings</a>
      <h2 class="mt-1 text-2xl font-bold">Web forms</h2>
      <p class="text-sm text-dim">Drop a quote-request form on your website — enquiries land straight in your pipeline as leads, tagged with where they came from.</p>
    </div>
    {notice && <p class="rounded-lg border border-emerald-800 bg-emerald-950 px-4 py-3 text-sm text-emerald-300">{notice}</p>}
    {error && <p class="rounded-lg border border-red-800 bg-red-950 px-4 py-3 text-sm text-red-300">{error}</p>}

    <form method="POST" class="space-y-3 rounded-2xl border border-edge bg-card p-4">
      <input type="hidden" name="intent" value="add" />
      <h3 class="font-bold">New form</h3>
      <input name="name" required placeholder="Form name (e.g. Website quote form)" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
      <textarea name="intro" rows="2" placeholder="Intro line shown above the form (optional)" class="w-full rounded-xl border border-edge-2 bg-surface px-4 py-3 text-base placeholder-faint focus:border-accent focus:outline-none"></textarea>
      {sources.length > 0 && (
        <label class="block space-y-1">
          <span class="text-sm text-dim">Tag enquiries with source</span>
          <select name="sourceId" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base focus:border-accent focus:outline-none">
            <option value="">No source</option>
            {sources.map((s) => <option value={s.id}>{s.name}</option>)}
          </select>
        </label>
      )}
      <button type="submit" class="w-full min-h-12 rounded-xl bg-primary font-semibold text-white hover:bg-primary-2">Create form</button>
    </form>

    {forms.length === 0 && (
      <p class="rounded-2xl border border-dashed border-edge-2 p-8 text-center text-sm text-faint">
        No forms yet. Create one and paste the embed code into your website — or send the direct link.
      </p>
    )}
    <div class="space-y-3">
      {forms.map((f) => (
        <div class="space-y-2 rounded-2xl border border-edge bg-card px-4 py-3">
          <div class="flex items-center justify-between gap-3">
            <span class="min-w-0">
              <span class="block truncate font-medium">{f.name}</span>
              <span class="block text-xs text-faint">{f.isActive ? 'Live' : 'Paused — returns Not found'}</span>
            </span>
            <div class="flex items-center gap-1">
              <form method="POST">
                <input type="hidden" name="intent" value="toggle" />
                <input type="hidden" name="formId" value={f.id} />
                <button type="submit" class={`min-h-12 rounded-lg px-3 text-xs font-semibold ${f.isActive ? 'text-emerald-400' : 'text-faint'}`}>
                  {f.isActive ? '● Live' : '○ Paused'}
                </button>
              </form>
              <form method="POST">
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="formId" value={f.id} />
                <button type="submit" class="min-h-12 min-w-10 rounded-lg text-faint hover:text-red-400" aria-label={`Delete ${f.name}`}>✕</button>
              </form>
            </div>
          </div>
          <input readonly value={`${base}/form/${f.token}`} onclick="this.select()" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-3 font-mono text-xs text-accent-text" />
          <textarea readonly rows="3" onclick="this.select()" class="w-full rounded-xl border border-edge-2 bg-surface px-3 py-2 font-mono text-xs text-dim">{embed(f.token)}</textarea>
        </div>
      ))}
    </div>
  </div>
</AppShell>
