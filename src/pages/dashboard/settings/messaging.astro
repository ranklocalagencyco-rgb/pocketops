---
/**
 * Messaging settings — the business line.
 * Established trades PORT their existing published number into Twilio (van,
 * Checkatrade, GBP listings all keep working); the CRM then routes every call
 * to their handset and fires the missed-call text-back. This page captures
 * the port request and manages routing.
 */
import { env } from 'cloudflare:workers';
import { and, desc, eq, ne } from 'drizzle-orm';
import AppShell from '../../../layouts/AppShell.astro';
import { createDb, tenantValues, tenantWhere } from '../../../db';
import { numberPortRequests, tenants } from '../../../db/schema';
import { newId } from '../../../lib/ids';
import { canSeeFinancials } from '../../../lib/masking';
import { twilioConfigured } from '../../../lib/twilio';

if (!canSeeFinancials(Astro.locals.userRole!)) return Astro.redirect('/dashboard/settings');
const tenantId = Astro.locals.tenantId!;
const db = createDb(env.DB);

let notice = '';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'settings');

  if (intent === 'settings') {
    try {
      await db
        .update(tenants)
        .set({
          twilioNumber: String(form.get('twilioNumber') ?? '').trim() || null,
          twilioForwardNumber: String(form.get('twilioForwardNumber') ?? '').trim() || null,
          missedCallMessage: String(form.get('missedCallMessage') ?? '').trim() || null,
          quietHoursStart: /^([01]\d|2[0-3]):[0-5]\d$/.test(String(form.get('quietHoursStart')))
            ? String(form.get('quietHoursStart'))
            : '08:00',
          quietHoursEnd: /^([01]\d|2[0-3]):[0-5]\d$/.test(String(form.get('quietHoursEnd')))
            ? String(form.get('quietHoursEnd'))
            : '20:00',
        })
        .where(eq(tenants.id, tenantId));
      notice = 'Messaging settings saved.';
    } catch {
      error = 'Could not save — that business number may already be in use by another workspace.';
    }
  } else if (intent === 'port') {
    const phoneNumber = String(form.get('phoneNumber') ?? '').trim();
    const numberType = String(form.get('numberType') ?? '') === 'landline' ? 'landline' : 'mobile';
    const pacCode = String(form.get('pacCode') ?? '').trim().toUpperCase();
    const accountHolder = String(form.get('accountHolder') ?? '').trim();
    const currentProvider = String(form.get('currentProvider') ?? '').trim();
    if (!phoneNumber || !accountHolder) {
      error = 'Please fill in the number you want to bring over and the account holder name.';
    } else if (numberType === 'mobile' && !pacCode) {
      error = 'Mobile ports need a PAC code — text PAC to 65075 from that phone to get one free.';
    } else {
      await db.insert(numberPortRequests).values(
        tenantValues(tenantId, {
          id: newId(),
          phoneNumber,
          numberType,
          pacCode: pacCode || null,
          accountHolder,
          currentProvider: currentProvider || null,
          status: 'requested',
        }),
      );
      notice = 'Port request received — we’ll take it from here and keep you posted below.';
    }
  } else if (intent === 'cancel-port') {
    const portId = String(form.get('portId') ?? '');
    await db
      .update(numberPortRequests)
      .set({ status: 'cancelled', updatedAt: new Date() })
      .where(
        tenantWhere(
          numberPortRequests,
          tenantId,
          and(eq(numberPortRequests.id, portId), eq(numberPortRequests.status, 'requested')),
        ),
      );
    notice = 'Port request cancelled.';
  }
}

const [tenant] = await db.select().from(tenants).where(eq(tenants.id, tenantId)).limit(1);
const [activePort] = await db
  .select()
  .from(numberPortRequests)
  .where(
    tenantWhere(
      numberPortRequests,
      tenantId,
      and(ne(numberPortRequests.status, 'cancelled'), ne(numberPortRequests.status, 'live')),
    ),
  )
  .orderBy(desc(numberPortRequests.createdAt))
  .limit(1);

const twilioReady = twilioConfigured(env);
const base = env.APP_URL || Astro.url.origin;

const PORT_STEPS = [
  { key: 'requested', label: 'Requested', desc: 'We’ve got your details' },
  { key: 'submitted', label: 'Submitted', desc: 'Filed with the carrier' },
  { key: 'scheduled', label: 'Scheduled', desc: 'Port date confirmed' },
  { key: 'live', label: 'Live', desc: 'Number running through Pocket Ops' },
];
const stepIndex = activePort ? PORT_STEPS.findIndex((s) => s.key === activePort.status) : -1;
---

<AppShell title="Messaging" active="settings">
  <div class="mx-auto max-w-xl space-y-5">
    <div>
      <a href="/dashboard/settings" class="text-sm text-dim hover:text-body">← Settings</a>
      <h2 class="mt-1 text-2xl font-bold">Messaging</h2>
      <p class="text-sm text-dim">Your business line rings your phone as normal — and missed calls get an instant text back so the lead never goes cold.</p>
    </div>
    {notice && <p class="rounded-lg border border-emerald-800 bg-emerald-950 px-4 py-3 text-sm text-emerald-300">{notice}</p>}
    {error && <p class="rounded-lg border border-red-800 bg-red-950 px-4 py-3 text-sm text-red-300">{error}</p>}

    {!activePort && !tenant?.twilioNumber && (
      <div class="space-y-4 rounded-2xl border border-accent-edge/60 bg-card p-5">
        <div>
          <p class="font-semibold">Bring your existing number with you</p>
          <p class="mt-1 text-sm text-dim">
            Keep the number that's already on your van, Checkatrade, and Google — we move it over so
            nothing you've printed or listed ever changes. Calls still ring your phone; missed ones get
            the instant text-back. Takes 1–4 weeks, and your number keeps working the whole time.
          </p>
        </div>
        <form method="POST" class="space-y-4">
          <input type="hidden" name="intent" value="port" />
          <label class="block space-y-1">
            <span class="text-sm text-dim">Number to bring over</span>
            <input name="phoneNumber" required placeholder="07700 900123" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
          </label>
          <label class="block space-y-1">
            <span class="text-sm text-dim">Number type</span>
            <select name="numberType" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base focus:border-accent focus:outline-none">
              <option value="mobile">Mobile (07…)</option>
              <option value="landline">Landline (01 / 02 / 03…)</option>
            </select>
          </label>
          <label class="block space-y-1">
            <span class="text-sm text-dim">PAC code (mobiles only)</span>
            <input name="pacCode" placeholder="ABC123456" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base uppercase placeholder-faint focus:border-accent focus:outline-none" />
            <span class="block text-xs text-faint">Text <span class="text-accent-text">PAC</span> to <span class="text-accent-text">65075</span> from that phone — it's free and arrives in a minute.</span>
          </label>
          <label class="block space-y-1">
            <span class="text-sm text-dim">Name on the phone account</span>
            <input name="accountHolder" required placeholder="e.g. John Smith / Smith Plumbing Ltd" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
          </label>
          <label class="block space-y-1">
            <span class="text-sm text-dim">Current provider (optional)</span>
            <input name="currentProvider" placeholder="e.g. EE, O2, Vodafone, BT" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
          </label>
          <div class="rounded-xl border border-edge bg-surface p-4 text-xs text-dim">
            <p class="font-semibold text-dim">Porting a mobile? Read this first.</p>
            <p class="mt-1">Your handset gets a fresh SIM with a new number, and your existing number becomes your business line: calls to it still ring your phone, but <span class="text-body">texts to it arrive in your Pocket Ops inbox</span> instead of your messages app. That's ideal for a work number — but if this number is also your personal one (bank codes, family), consider a new business number instead.</p>
          </div>
          <button type="submit" class="w-full min-h-12 rounded-xl bg-primary hover:bg-primary-2 font-semibold text-white active:scale-[0.99]">Start my number move</button>
        </form>
      </div>
    )}

    {activePort && (
      <div class="space-y-4 rounded-2xl border border-edge bg-card p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="font-semibold">Moving {activePort.phoneNumber}</p>
            <p class="text-sm text-dim">{activePort.numberType === 'mobile' ? 'Mobile port' : 'Landline port'} — your number keeps working throughout.</p>
          </div>
          {activePort.status === 'requested' && (
            <form method="POST">
              <input type="hidden" name="intent" value="cancel-port" />
              <input type="hidden" name="portId" value={activePort.id} />
              <button type="submit" class="min-h-10 rounded-lg border border-edge-2 px-3 text-xs text-dim hover:text-body">Cancel</button>
            </form>
          )}
        </div>
        <ol class="space-y-2">
          {PORT_STEPS.map((s, i) => (
            <li class={`flex items-center gap-3 rounded-xl border px-4 py-2.5 text-sm ${i <= stepIndex ? 'border-emerald-800 bg-emerald-950/40' : 'border-edge bg-surface'}`}>
              <span class={i <= stepIndex ? 'text-emerald-400' : 'text-faint'}>{i <= stepIndex ? '✓' : '○'}</span>
              <span class={`font-medium ${i <= stepIndex ? 'text-emerald-300' : 'text-dim'}`}>{s.label}</span>
              <span class="text-xs text-faint">{s.desc}</span>
              {s.key === 'scheduled' && activePort.portDate && (
                <span class="ml-auto text-xs text-accent-text">{activePort.portDate.toLocaleDateString('en-GB')}</span>
              )}
            </li>
          ))}
        </ol>
        {activePort.notes && <p class="text-xs text-faint">{activePort.notes}</p>}
      </div>
    )}

    <p class={`rounded-xl border px-4 py-3 text-sm ${twilioReady ? 'border-emerald-800 bg-emerald-950 text-emerald-300' : 'border-edge bg-card text-dim'}`}>
      {twilioReady ? '● Phone system connected' : '○ Phone system not live on this installation yet.'}
    </p>

    <form method="POST" class="space-y-4 rounded-2xl border border-edge bg-card p-5">
      <input type="hidden" name="intent" value="settings" />
      <p class="font-semibold">Call routing</p>
      <label class="block space-y-1">
        <span class="text-sm text-dim">Business number (E.164)</span>
        <input name="twilioNumber" value={tenant?.twilioNumber ?? ''} placeholder="+447700900123" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <span class="block text-xs text-faint">Filled in automatically once your ported number goes live.</span>
      </label>
      <label class="block space-y-1">
        <span class="text-sm text-dim">Ring through to (your handset)</span>
        <input name="twilioForwardNumber" value={tenant?.twilioForwardNumber ?? ''} placeholder="+447700900456" class="w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <span class="block text-xs text-faint">Every call to your business number rings this phone. After a mobile port, this is your new SIM's number.</span>
      </label>
      <label class="block space-y-1">
        <span class="text-sm text-dim">Text-back message</span>
        <textarea name="missedCallMessage" rows="3" placeholder={`Sorry we missed your call — this is ${tenant?.name}. Reply here and we'll get right back to you!`} class="w-full rounded-xl border border-edge-2 bg-surface px-4 py-3 text-base placeholder-faint focus:border-accent focus:outline-none">{tenant?.missedCallMessage ?? ''}</textarea>
        <span class="block text-xs text-faint">Use {'{name}'} to greet known customers by first name. Leave blank for the default message.</span>
      </label>
      <div class="space-y-1">
        <p class="text-sm text-dim">Quiet hours</p>
        <div class="flex items-center gap-2">
          <input type="time" name="quietHoursStart" value={tenant?.quietHoursStart ?? '08:00'} class="min-h-12 rounded-xl border border-edge-2 bg-surface px-3 text-base focus:border-accent focus:outline-none" />
          <span class="text-sm text-faint">to</span>
          <input type="time" name="quietHoursEnd" value={tenant?.quietHoursEnd ?? '20:00'} class="min-h-12 rounded-xl border border-edge-2 bg-surface px-3 text-base focus:border-accent focus:outline-none" />
        </div>
        <span class="block text-xs text-faint">Automated texts — invoice reminders, service nudges, review requests — only send between these times ({tenant?.timezone ?? 'Europe/London'}). Missed-call text-backs and your own replies always send straight away.</span>
      </div>
      <button type="submit" class="w-full min-h-12 rounded-xl bg-primary font-semibold text-white hover:bg-primary-2">Save changes</button>
    </form>

    <div class="rounded-2xl border border-edge bg-card p-5 text-sm">
      <p class="font-semibold">Number wiring (done for you)</p>
      <p class="mt-1 text-dim">Once the number is in Twilio, its Voice URL and Messaging URL point here — calls route through the CRM and texts land in your inbox:</p>
      <input readonly value={`${base}/api/webhooks/twilio-voice`} onclick="this.select()" class="mt-2 w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-3 font-mono text-xs text-accent-text" />
      <input readonly value={`${base}/api/webhooks/twilio-sms`} onclick="this.select()" class="mt-2 w-full min-h-12 rounded-xl border border-edge-2 bg-surface px-3 font-mono text-xs text-accent-text" />
    </div>
  </div>
</AppShell>
