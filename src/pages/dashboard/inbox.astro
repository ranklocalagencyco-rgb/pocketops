---
import { env } from 'cloudflare:workers';
import { desc, eq, isNotNull, isNull } from 'drizzle-orm';
import AppShell from '../../layouts/AppShell.astro';
import { createDb, tenantWhere } from '../../db';
import { customers, emailAccounts, messages, tenants } from '../../db/schema';
import { sendAndLogEmail } from '../../lib/email';
import { fmtDateTz } from '../../lib/jobs';
import { sendAndLogSms } from '../../lib/messages';
import { twilioConfigured } from '../../lib/twilio';

const tenantId = Astro.locals.tenantId!;
const db = createDb(env.DB);

const [tenant] = await db.select().from(tenants).where(eq(tenants.id, tenantId)).limit(1);
const tz = tenant?.timezone;
const canSend = twilioConfigured(env) && Boolean(tenant?.twilioNumber);

const withPhone = (Astro.url.searchParams.get('with') ?? '').trim();
let sendError = '';

if (Astro.request.method === 'POST' && withPhone) {
  const form = await Astro.request.formData();
  const body = String(form.get('body') ?? '').trim().slice(0, 1600);
  const [latest] = await db
    .select({ kind: messages.kind, customerId: messages.customerId })
    .from(messages)
    .where(tenantWhere(messages, tenantId, eq(messages.phone, withPhone)))
    .orderBy(desc(messages.createdAt))
    .limit(1);
  if (!body) {
    sendError = 'Type a message first.';
  } else if (latest?.kind === 'email') {
    // Email thread → reply through the connected mailbox
    const [account] = await db
      .select()
      .from(emailAccounts)
      .where(tenantWhere(emailAccounts, tenantId, eq(emailAccounts.status, 'active')))
      .limit(1);
    if (!account) {
      sendError = 'Connect a mailbox in Settings → Email to reply to emails.';
    } else {
      const [lastSubject] = await db
        .select({ subject: messages.subject })
        .from(messages)
        .where(tenantWhere(messages, tenantId, eq(messages.phone, withPhone), isNotNull(messages.subject)))
        .orderBy(desc(messages.createdAt))
        .limit(1);
      const subject = lastSubject?.subject
        ? lastSubject.subject.replace(/^(Re:\s*)?/i, 'Re: ')
        : `Message from ${tenant?.name}`;
      const result = await sendAndLogEmail(db, env, account, {
        to: withPhone,
        subject,
        text: body,
        customerId: latest?.customerId,
      });
      if (!result.ok) sendError = result.error ?? 'Email failed to send.';
    }
  } else if (!canSend) {
    sendError = 'Connect Twilio and set your number in Settings → Messaging first.';
  } else {
    const [match] = await db
      .select({ id: customers.id })
      .from(customers)
      .where(tenantWhere(customers, tenantId, eq(customers.phone, withPhone)))
      .limit(1);
    const result = await sendAndLogSms(db, env, tenantId, {
      to: withPhone,
      from: tenant!.twilioNumber!,
      body,
      customerId: match?.id,
    });
    if (!result.ok) sendError = 'Message failed to send. Check your Twilio setup.';
  }
}

// Mark the open thread read
if (withPhone) {
  await db
    .update(messages)
    .set({ readAt: new Date() })
    .where(
      tenantWhere(messages, tenantId, eq(messages.phone, withPhone), eq(messages.direction, 'in'), isNull(messages.readAt)),
    );
}

const all = await db
  .select({
    id: messages.id,
    direction: messages.direction,
    kind: messages.kind,
    phone: messages.phone,
    subject: messages.subject,
    body: messages.body,
    readAt: messages.readAt,
    createdAt: messages.createdAt,
    customerName: customers.name,
  })
  .from(messages)
  .leftJoin(customers, eq(messages.customerId, customers.id))
  .where(tenantWhere(messages, tenantId))
  .orderBy(desc(messages.createdAt))
  .limit(500);

// Thread list: newest message per counterparty (phone or email) + unread count
const threads: { phone: string; name: string | null; last: string; when: Date; unread: number; kind: string }[] = [];
for (const m of all) {
  let t = threads.find((x) => x.phone === m.phone);
  if (!t) {
    t = { phone: m.phone, name: m.customerName, last: m.subject || m.body, when: m.createdAt, unread: 0, kind: m.kind };
    threads.push(t);
  }
  if (!t.name && m.customerName) t.name = m.customerName;
  if (m.direction === 'in' && !m.readAt) t.unread++;
}
const thread = withPhone ? all.filter((m) => m.phone === withPhone).reverse() : [];
const threadName = threads.find((t) => t.phone === withPhone)?.name ?? withPhone;
---

<AppShell title="Inbox" active="inbox">
  {!withPhone ? (
    <div class="space-y-4">
      <h1 class="text-xl font-bold">Inbox</h1>
      {!canSend && (
        <p class="rounded-xl border border-edge bg-card px-4 py-3 text-sm text-dim">
          Connect Twilio in <a href="/dashboard/settings/messaging" class="text-accent-text hover:underline">Settings → Messaging</a> and point the number's SMS webhook at <span class="font-mono text-xs">/api/webhooks/twilio-sms</span> to receive replies here.
        </p>
      )}
      {threads.length === 0 ? (
        <p class="rounded-2xl border border-dashed border-edge-2 p-8 text-center text-sm text-faint">
          No messages yet. Reminders, text-backs, and customer replies all land here.
        </p>
      ) : (
        <div class="space-y-2">
          {threads.map((t) => (
            <a href={`/dashboard/inbox?with=${encodeURIComponent(t.phone)}`} class="flex min-h-16 items-center justify-between gap-3 rounded-2xl border border-edge bg-card px-4 py-3 hover:border-accent/50">
              <div class="min-w-0">
                <p class="font-medium">{t.kind === 'email' ? '✉️' : '💬'} {t.name ?? t.phone}</p>
                <p class="truncate text-sm text-dim">{t.last}</p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                {t.unread > 0 && <span class="rounded-full bg-primary px-2 py-0.5 text-xs font-bold text-white">{t.unread}</span>}
                <span class="text-xs text-faint">{fmtDateTz(t.when, tz)}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="flex min-h-[70vh] flex-col space-y-4">
      <div>
        <a href="/dashboard/inbox" class="text-sm text-dim hover:text-body">← Inbox</a>
        <div class="mt-1 flex items-center justify-between">
          <h1 class="text-xl font-bold">{threadName}</h1>
          <a href={`tel:${withPhone}`} class="flex min-h-12 items-center rounded-xl border border-edge-2 px-4 text-sm text-dim hover:border-accent">📞 Call</a>
        </div>
      </div>
      <div class="flex-1 space-y-2 overflow-y-auto">
        {thread.map((m) => (
          <div class={`max-w-[85%] rounded-2xl px-4 py-2.5 ${m.direction === 'out' ? 'ml-auto bg-primary text-white' : 'bg-card-2 text-body'}`}>
            {m.kind === 'email' && m.subject && <p class="text-xs font-bold">✉️ {m.subject}</p>}
            <p class="whitespace-pre-wrap text-sm">{m.body}</p>
            <p class={`mt-1 text-[10px] ${m.direction === 'out' ? 'text-white/70' : 'text-faint'}`}>{fmtDateTz(m.createdAt, tz)}</p>
          </div>
        ))}
      </div>
      {sendError && <p class="rounded-lg border border-red-800 bg-red-950 px-4 py-3 text-sm text-red-300">{sendError}</p>}
      <form method="POST" class="flex gap-2">
        <input name="body" id="reply-body" required placeholder="Type a reply…" autocomplete="off" class="min-h-12 flex-1 rounded-xl border border-edge-2 bg-card px-4 text-base placeholder-faint focus:border-accent focus:outline-none" />
        <button type="button" id="ai-draft" title="Draft a reply with AI" class="min-h-12 rounded-xl border border-edge-2 px-3 text-lg hover:border-accent">✨</button>
        <button type="submit" class="min-h-12 rounded-xl bg-primary px-5 font-semibold text-white hover:bg-primary-2">Send</button>
      </form>
    </div>
  )}
</AppShell>

<script>
  document.getElementById('ai-draft')?.addEventListener('click', async () => {
    const input = document.getElementById('reply-body') as HTMLInputElement;
    const btn = document.getElementById('ai-draft') as HTMLButtonElement;
    const phone = new URLSearchParams(window.location.search).get('with');
    if (!phone) return;
    btn.disabled = true;
    btn.textContent = '…';
    try {
      const res = await fetch('/api/app/ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'reply', phone }),
      });
      const json = (await res.json()) as { draft?: string };
      if (json.draft) {
        input.value = json.draft;
        input.focus();
      } else {
        input.placeholder = 'AI unavailable — type your reply';
      }
    } catch {
      input.placeholder = 'AI unavailable — type your reply';
    }
    btn.disabled = false;
    btn.textContent = '✨';
  });
</script>
