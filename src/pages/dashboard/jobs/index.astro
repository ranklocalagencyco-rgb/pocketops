---
import { env } from 'cloudflare:workers';
import { desc, eq, like, or } from 'drizzle-orm';
import AppShell from '../../../layouts/AppShell.astro';
import { createDb, tenantWhere } from '../../../db';
import { customers, jobs, JOB_STATUSES, type JobStatus } from '../../../db/schema';
import { fmtMoney, STATUS_LABELS } from '../../../lib/jobs';

const tenantId = Astro.locals.tenantId!;
const role = Astro.locals.userRole!;
// Field roles see only their assigned work orders
const isFieldRole = role === 'technician' || role === 'apprentice';
const db = createDb(env.DB);

const statusParam = Astro.url.searchParams.get('status');
const filter = JOB_STATUSES.includes(statusParam as JobStatus) ? (statusParam as JobStatus) : null;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const search = q ? or(like(jobs.title, `%${q}%`), like(customers.name, `%${q}%`)) : undefined;

const rows = await db
  .select({
    id: jobs.id,
    title: jobs.title,
    status: jobs.status,
    totalCents: jobs.totalCents,
    scheduledAt: jobs.scheduledAt,
    updatedAt: jobs.updatedAt,
    customerName: customers.name,
  })
  .from(jobs)
  .innerJoin(customers, eq(jobs.customerId, customers.id))
  .where(
    tenantWhere(
      jobs,
      tenantId,
      filter ? eq(jobs.status, filter) : undefined,
      isFieldRole ? eq(jobs.assignedUserId, Astro.locals.userId!) : undefined,
      search,
    ),
  )
  .orderBy(desc(jobs.updatedAt));

// Heat: leads/quotes going cold — amber at 5+ days untouched, red at 10+
const DAY_MS = 24 * 60 * 60 * 1000;
const heat = (j: { status: JobStatus; updatedAt: Date }): string | null => {
  if (j.status !== 'lead' && j.status !== 'quoted') return null;
  const idle = Date.now() - j.updatedAt.getTime();
  if (idle > 10 * DAY_MS) return 'bg-red-400';
  if (idle > 5 * DAY_MS) return 'bg-accent';
  return null;
};

const statusColors: Record<JobStatus, string> = {
  lead: 'bg-sky-950 text-sky-300 border-sky-800',
  quoted: 'bg-violet-950 text-violet-300 border-violet-800',
  approved: 'bg-cyan-950 text-cyan-300 border-cyan-800',
  scheduled: 'bg-blue-950 text-blue-300 border-blue-800',
  in_progress: 'bg-accent-soft text-accent-text border-accent-edge',
  completed: 'bg-lime-950 text-lime-300 border-lime-800',
  invoiced: 'bg-accent-soft text-accent-text border-accent-edge',
  paid: 'bg-emerald-950 text-emerald-300 border-emerald-800',
  cancelled: 'bg-card-2 text-dim border-edge-2',
};
---

<AppShell title="Jobs" active="jobs">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold">
        Jobs{filter ? ` · ${STATUS_LABELS[filter]}` : ''}{q ? ` · “${q}”` : ''}
      </h1>
      <a href="/dashboard/jobs/new" class="flex min-h-12 items-center rounded-xl bg-primary px-4 font-semibold text-white hover:bg-primary-2">+ New</a>
    </div>

    <div class="flex gap-2 overflow-x-auto pb-1">
      <a href="/dashboard/jobs" class={`flex min-h-12 items-center whitespace-nowrap rounded-xl border px-4 text-sm ${!filter ? 'border-accent text-accent-text' : 'border-edge-2 text-dim'}`}>All</a>
      {JOB_STATUSES.map((s) => (
        <a href={`/dashboard/jobs?status=${s}`} class={`flex min-h-12 items-center whitespace-nowrap rounded-xl border px-4 text-sm ${filter === s ? 'border-accent text-accent-text' : 'border-edge-2 text-dim'}`}>
          {STATUS_LABELS[s]}
        </a>
      ))}
    </div>

    {rows.length === 0 && (
      <p class="rounded-2xl border border-dashed border-edge-2 p-8 text-center text-faint">Nothing here yet.</p>
    )}
    <div class="space-y-2">
      {rows.map((j) => (
        <a href={`/dashboard/jobs/${j.id}`} class="flex min-h-16 items-center justify-between gap-3 rounded-2xl border border-edge bg-card px-4 py-3 hover:border-accent/50">
          <div class="min-w-0">
            <p class="flex items-center gap-2 truncate font-medium">
              {heat(j) && <span class={`h-2 w-2 shrink-0 rounded-full ${heat(j)}`} title="No movement in 5+ days" />}
              <span class="truncate">{j.title}</span>
            </p>
            <p class="truncate text-sm text-dim">
              {j.customerName}{j.scheduledAt ? ` · ${j.scheduledAt.toLocaleDateString('en-GB')}` : ''}
            </p>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-semibold">{fmtMoney(j.totalCents)}</span>
            <span class={`rounded-full border px-2.5 py-1 text-xs ${statusColors[j.status]}`}>{STATUS_LABELS[j.status]}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</AppShell>
