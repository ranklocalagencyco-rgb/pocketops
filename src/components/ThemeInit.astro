{/* Sets data-theme before first paint: cookie wins, otherwise the device
    preference. Light is the [data-app] default, so no-JS users get light. */}
<script is:inline>
  (function () {
    var m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
    var t = m ? m[1] : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = t;
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', t === 'dark' ? '#0b1524' : '#f4f6f9');
  })();
</script>
