# Copy to .dev.vars for local dev; set as Cloudflare Pages secrets for prod.
# Everything is optional — features light up as credentials are added.

# Canonical origin (OAuth callbacks, Twilio signature URL, magic links)
APP_URL="http://localhost:4321"

# Daily automations endpoint (/api/cron/daily) — set any long random string,
# then hit the endpoint daily from a Cloudflare Worker cron or uptime service.
CRON_SECRET=""

# Module 6 — Stripe Connect (platform account key, sk_...). Tenants connect
# their own Standard accounts in Settings → Payments; charges are created on
# THEIR account, so money never touches the platform.
STRIPE_SECRET_KEY=""
# Webhook endpoint must be a CONNECT endpoint: Stripe dashboard → Webhooks →
# Add endpoint → "Listen to events on Connected accounts" →
# checkout.session.completed → paste its signing secret here.
STRIPE_WEBHOOK_SECRET=""
# Optional platform fee on each payment, in basis points (100 = 1%). Empty/0 = none.
PLATFORM_FEE_BPS=""

# Module 7/8 — Twilio missed-call text-back + review SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Unified email inbox — Google Cloud OAuth app (scope: gmail.modify)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Unified email inbox — Microsoft Entra app (scopes: Mail.Read Mail.Send)
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# Module 9 — QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"

# Module 9 — Xero
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
